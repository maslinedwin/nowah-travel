#!/usr/bin/python3
"""nowah-sync - state synchronizer for the Nowah Omarchy plugin.

Talks only to the pinned Nowah production origin (device-code pairing +
read-only trip data) and maintains an atomic snapshot at
$STATE_DIR/status.json which the Quickshell side (NowahService.qml) reads
through this same helper.

Security posture (see README "Privacy & disclosure"):

  * No PATH resolution anywhere. This is Python stdlib only - no curl, jq,
    stat, mv, head, timeout or any other external program is executed for
    state or secret handling, so a shadowed tool can never see a credential.
    The one process ever launched is the browser opener, resolved from a
    fixed list of absolute paths and verified (regular, executable, not
    group/world-writable) before exec, with a sanitized environment.

  * Every open is safe by construction, not by checking first: the state
    directory is opened O_DIRECTORY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC and
    fstat-verified, and every leaf is opened *relative to that descriptor*
    with O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC and fstat-verified (regular file,
    ours, one link, bounded) before a byte is read. A symlink fails the open
    with ELOOP; a FIFO returns immediately and fails the fstat. There is no
    check-then-open window because the kernel enforces the invariants.

  * Publication is O_CREAT|O_EXCL|O_NOFOLLOW at the directory descriptor,
    written and fsynced through that descriptor, then renamed with both
    sides descriptor-relative. Runs are serialised with flock on the
    directory descriptor itself; there is no lock file.

  * Secrets live only in this process's memory and in 0600 files; they never
    appear in any argv or environment.

  * Responses are bounded on the wire (read limit+1, reject the extra byte)
    and reduced through a strict whitelist schema before they are published.
    One absolute deadline bounds the whole run.

Subcommands:
  refresh          sync trips (NOWAH_FLIGHT / NOWAH_FLIGHT_DATE add flight status)
  pair-start       begin pairing (verification URL lands in status.json)
  pair-poll        poll for approval (exit 10 = pending, poll again)
  disconnect       forget token + pairing
  read-snapshot    print status.json, bounded; exit 2 if it exceeds the cap
  launch PATH      open a pinned-origin app path in the Nowah web app window
"""

import errno
import fcntl
import json
import os
import re
import ssl
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# --------------------------------------------------------------------------
# pinned origins + developer override
# --------------------------------------------------------------------------

PROD_API_ORIGIN = "https://api.nowah.xyz"
APP_ORIGIN = "https://app.nowah.xyz"
STATE_LEAF = "nowah-omarchy"

DEV_ORIGIN_RE = re.compile(r"^https://[a-z0-9.-]+(:[0-9]{1,5})?$")

API_ORIGIN = PROD_API_ORIGIN
_dev = os.environ.get("NOWAH_DEV_API_ORIGIN", "")
if _dev:
    if os.environ.get("NOWAH_DEV_CONSENT") != "1":
        sys.stderr.write("nowah-sync: NOWAH_DEV_API_ORIGIN requires NOWAH_DEV_CONSENT=1\n")
        sys.exit(2)
    if not DEV_ORIGIN_RE.match(_dev):
        sys.stderr.write("nowah-sync: NOWAH_DEV_API_ORIGIN must be an https origin with no path\n")
        sys.exit(2)
    API_ORIGIN = _dev
    STATE_LEAF = "nowah-omarchy-dev"

SHOW_NOTIFICATIONS = os.environ.get("NOWAH_SHOW_NOTIFICATIONS") == "1"

TOKEN_LEAF = "token"
DEVICE_LEAF = "device.json"
STATUS_LEAF = "status.json"

# --------------------------------------------------------------------------
# bounds
# --------------------------------------------------------------------------

RUN_BUDGET_S = 40.0
MAX_BODY_TRIPS = 512 * 1024
MAX_BODY_SMALL = 32 * 1024
MAX_STATUS_BYTES = 256 * 1024
MAX_SECRET_FILE = 4096
MAX_TRIPS = 25
MAX_FLIGHTS = 12
FLIGHT_STATUS_MAX_AGE_S = 12 * 3600
CONNECT_TIMEOUT_S = 10.0

DEADLINE = time.monotonic() + RUN_BUDGET_S
PARENT_PID = os.getppid()

TOKEN_RE = re.compile(r"^nowah_dev_[A-Za-z0-9_-]{20,128}$")
DEVICE_CODE_RE = re.compile(r"^[a-f0-9]{64}$")
USER_CODE_RE = re.compile(r"^[A-Z0-9]{4}-[A-Z0-9]{4}$")
IDENT_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}")
FLIGHT_NUM_RE = re.compile(r"^[A-Z0-9]{2,8}$")
APP_PATH_RE = re.compile(r"^/[A-Za-z0-9/_?=&.-]{0,200}$")
# Markup delimiters, C0/C1 controls, and format/bidi/zero-width characters.
STRIP_RE = re.compile(
    "[<>\u0000-\u001f\u007f-\u009f\u00ad\u061c\u180e\u200b-\u200f"
    "\u2028-\u202e\u2060-\u2069\ufeff\ufff9-\ufffb]"
)

OPEN_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC


class Fail(Exception):
    """Fatal, fail-closed error; nothing is published."""


def remaining() -> float:
    return max(0.0, DEADLINE - time.monotonic())


def parent_alive() -> bool:
    """Stop before network work if our supervising process is gone."""
    return os.getppid() == PARENT_PID


def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# --------------------------------------------------------------------------
# descriptor-bound state I/O
# --------------------------------------------------------------------------


class State:
    """The state directory, held open as a verified descriptor."""

    def __init__(self) -> None:
        base = os.environ.get("XDG_STATE_HOME") or ""
        if not base.startswith("/"):
            home = os.environ.get("HOME") or ""
            if not home.startswith("/"):
                raise Fail("HOME must be an absolute path")
            base = os.path.join(home, ".local", "state")
        self.path = os.path.join(base, STATE_LEAF)
        os.makedirs(base, exist_ok=True)
        try:
            os.mkdir(self.path, 0o700)
        except FileExistsError:
            pass
        # O_DIRECTORY refuses a non-directory, O_NOFOLLOW refuses a symlink,
        # O_NONBLOCK means a planted FIFO can never block this open.
        try:
            self.fd = os.open(
                self.path,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            )
        except OSError as exc:
            raise Fail("cannot open state dir: %s" % errno.errorcode.get(exc.errno, exc.errno))
        st = os.fstat(self.fd)
        if not stat.S_ISDIR(st.st_mode):
            raise Fail("state dir is not a directory")
        if st.st_uid != os.geteuid():
            raise Fail("state dir not owned by us")
        os.fchmod(self.fd, 0o700)
        self._sweep()

    def lock(self) -> bool:
        """Serialise runs on the directory descriptor itself (no lock file)."""
        deadline = time.monotonic() + min(remaining(), 15.0)
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except OSError:
                if time.monotonic() >= deadline:
                    return False
                time.sleep(0.2)

    def _sweep(self) -> None:
        """Remove temp leaves from runs that died long ago."""
        cutoff = time.time() - 600
        try:
            names = os.listdir(self.fd)
        except OSError:
            return
        for name in names:
            if not name.startswith(".tmp."):
                continue
            try:
                st = os.stat(name, dir_fd=self.fd, follow_symlinks=False)
                if stat.S_ISREG(st.st_mode) and st.st_mtime < cutoff:
                    os.unlink(name, dir_fd=self.fd)
            except OSError:
                pass

    def read(self, name: str, limit: int):
        """Open no-follow/non-blocking relative to the directory descriptor and
        fstat the OPENED object before reading. Returns bytes, or None when the
        leaf is absent, not ours, not a regular file, or over the limit."""
        try:
            fd = os.open(name, OPEN_FLAGS, dir_fd=self.fd)
        except OSError:
            # ENOENT, ELOOP (symlink), ENXIO, EACCES ... all mean "not usable".
            return None
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                return None
            if st.st_uid != os.geteuid() or st.st_nlink != 1:
                return None
            if st.st_size > limit:
                return None
            data = b""
            while len(data) <= limit:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                data += chunk
            return data if len(data) <= limit else None
        finally:
            os.close(fd)

    def publish(self, name: str, data: bytes) -> None:
        """O_EXCL temp at the directory descriptor -> write -> fsync -> rename,
        both sides descriptor-relative. Nothing existing is ever opened, so a
        swapped-in target cannot be truncated; rename replaces a symlink
        without following it."""
        tmp = ".tmp.%s" % os.urandom(6).hex()
        fd = os.open(
            tmp,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=self.fd,
        )
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_size != 0:
                raise Fail("temp leaf is not a fresh regular file")
            os.write(fd, data)
            os.fsync(fd)
        except BaseException:
            os.close(fd)
            try:
                os.unlink(tmp, dir_fd=self.fd)
            except OSError:
                pass
            raise
        os.close(fd)
        try:
            os.rename(tmp, name, src_dir_fd=self.fd, dst_dir_fd=self.fd)
        except OSError as exc:
            try:
                os.unlink(tmp, dir_fd=self.fd)
            except OSError:
                pass
            raise Fail("cannot publish %s: %s" % (name, errno.errorcode.get(exc.errno, exc.errno)))

    def remove(self, name: str) -> None:
        try:
            os.unlink(name, dir_fd=self.fd)  # never follows a symlink
        except OSError:
            pass

    def exists(self, name: str) -> bool:
        try:
            st = os.stat(name, dir_fd=self.fd, follow_symlinks=False)
        except OSError:
            return False
        return stat.S_ISREG(st.st_mode)


# --------------------------------------------------------------------------
# schema - the only path into status.json
# --------------------------------------------------------------------------


def s_str(value, limit):
    if not isinstance(value, str):
        return None
    return STRIP_RE.sub("", value)[:limit]


def s_num(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if value != value or value in (float("inf"), float("-inf")):
        return None
    if value > 1e9 or value < -1e9:
        return None
    return value


def s_date(value):
    if not isinstance(value, str) or not DATE_RE.match(value):
        return None
    return value[:32]


def s_ident(value):
    return value if isinstance(value, str) and IDENT_RE.match(value) else None


def s_flight(raw):
    if not isinstance(raw, dict):
        return None
    return {
        "flightNumber": s_str(raw.get("flightNumber"), 12),
        "depCode": s_str(raw.get("depCode"), 4),
        "arrCode": s_str(raw.get("arrCode"), 4),
        "depAt": s_date(raw.get("depAt")),
        "arrAt": s_date(raw.get("arrAt")),
    }


def s_trip(raw):
    if not isinstance(raw, dict):
        return None
    ident = s_ident(raw.get("id"))
    if ident is None:
        return None
    flights = []
    for item in raw.get("flights") or []:
        if len(flights) >= MAX_FLIGHTS:
            break
        flight = s_flight(item)
        if flight:
            flights.append(flight)
    weather = raw.get("weather")
    if isinstance(weather, dict):
        weather = {"temp": s_num(weather.get("temp")), "condition": s_str(weather.get("condition"), 40)}
    else:
        weather = None
    date_range = raw.get("dateRange")
    if isinstance(date_range, dict):
        date_range = {"start": s_date(date_range.get("start")), "end": s_date(date_range.get("end"))}
    else:
        date_range = None
    return {
        "id": ident,
        "name": s_str(raw.get("name"), 80),
        "status": s_str(raw.get("status"), 32),
        "tripStatus": s_str(raw.get("tripStatus"), 32),
        "startDate": s_date(raw.get("startDate")),
        "endDate": s_date(raw.get("endDate")),
        "dateRange": date_range,
        "destination": s_str(raw.get("destination"), 80),
        "destinationCity": s_str(raw.get("destinationCity"), 60),
        "destinationCountry": s_str(raw.get("destinationCountry"), 60),
        "weather": weather,
        "flights": flights,
    }


def s_trips(raw):
    trips = []
    if isinstance(raw, list):
        for item in raw:
            if len(trips) >= MAX_TRIPS:
                break
            trip = s_trip(item)
            if trip:
                trips.append(trip)
    return trips


def s_pairing(raw):
    if not isinstance(raw, dict):
        return None
    code = raw.get("userCode")
    if not isinstance(code, str) or not USER_CODE_RE.match(code):
        return None
    url = raw.get("verificationUrl")
    expected = "%s/device?code=%s" % (APP_ORIGIN, code)
    interval = s_num(raw.get("interval"))
    return {
        "userCode": code,
        "verificationUrl": url if url == expected else None,
        "expiresAt": s_date(raw.get("expiresAt")),
        "interval": 5 if interval is None else int(max(1, min(60, round(interval)))),
    }


def s_flight_status(raw, want=None, max_age=None):
    if not isinstance(raw, dict):
        return None
    number = s_str(raw.get("flightNumber"), 12)
    if want is not None and number != want:
        return None
    fetched = s_date(raw.get("fetchedAt"))
    if max_age is not None:
        if not fetched:
            return None
        try:
            age = time.time() - time.mktime(time.strptime(fetched[:19], "%Y-%m-%dT%H:%M:%S"))
        except ValueError:
            return None
        if age > max_age:
            return None
    data = raw.get("data") if isinstance(raw.get("data"), dict) else {}
    return {
        "flightNumber": number,
        "fetchedAt": fetched,
        "data": {
            "status": s_str(data.get("status"), 24),
            "delayMinutes": s_num(data.get("delayMinutes")),
            "progressPercent": s_num(data.get("progressPercent")),
            "gate": s_str(data.get("gate"), 8),
            "terminal": s_str(data.get("terminal"), 8),
        },
    }


def api_flight_status(payload, number):
    data = payload if isinstance(payload, dict) else {}
    delays = data.get("delays") if isinstance(data.get("delays"), dict) else {}
    departure = data.get("departure") if isinstance(data.get("departure"), dict) else {}

    def first(*values):
        for value in values:
            if value is not None:
                return value
        return None

    return {
        "flightNumber": number,
        "fetchedAt": now_iso(),
        "data": {
            "status": s_str(first(data.get("status"), data.get("flightStatus")), 24),
            "delayMinutes": s_num(first(data.get("delayMinutes"), data.get("departureDelay"), delays.get("departure"))),
            "progressPercent": s_num(first(data.get("progressPercent"), data.get("progress"))),
            "gate": s_str(first(data.get("gate"), data.get("departureGate"), departure.get("gate")), 8),
            "terminal": s_str(first(data.get("terminal"), departure.get("terminal")), 8),
        },
    }


def build_status(state_name, auth_error, pairing, trips, unread, flight_status, ok, sync_error):
    doc = {
        "version": 1,
        "generatedAt": now_iso(),
        "auth": {
            "state": state_name,
            "error": s_str(auth_error, 120) or None,
            "pairing": pairing,
            "profile": None,
        },
        "trips": trips,
        "unreadCount": unread,
        "flightStatus": flight_status,
        "lastSync": {"ok": bool(ok), "at": now_iso(), "error": s_str(sync_error, 120) or None},
    }
    data = json.dumps(doc, separators=(",", ":")).encode() + b"\n"
    if len(data) > MAX_STATUS_BYTES:  # fail closed, never publish an oversized snapshot
        doc["trips"] = []
        doc["flightStatus"] = None
        doc["lastSync"] = {"ok": False, "at": now_iso(), "error": "snapshot exceeded size limit"}
        data = json.dumps(doc, separators=(",", ":")).encode() + b"\n"
    return data


# --------------------------------------------------------------------------
# previous snapshot (re-validated through the same schema)
# --------------------------------------------------------------------------


def load_prev(state):
    raw = state.read(STATUS_LEAF, MAX_STATUS_BYTES)
    if raw is None:
        return {}
    try:
        doc = json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        return {}
    return doc if isinstance(doc, dict) else {}


def prev_trips(prev):
    return s_trips(prev.get("trips"))


def prev_unread(prev):
    value = s_num(prev.get("unreadCount"))
    return 0 if value is None else int(max(0, min(9999, value)))


def prev_pairing(prev):
    auth = prev.get("auth") if isinstance(prev.get("auth"), dict) else {}
    return s_pairing(auth.get("pairing"))


def prev_auth_error(prev):
    auth = prev.get("auth") if isinstance(prev.get("auth"), dict) else {}
    return s_str(auth.get("error"), 120) or ""


# --------------------------------------------------------------------------
# HTTP - stdlib only; credentials stay in memory
# --------------------------------------------------------------------------

SSL_CONTEXT = ssl.create_default_context()
SSL_CONTEXT.minimum_version = ssl.TLSVersion.TLSv1_2


def request(url, limit, bearer=None, body=None):
    """Returns (status, bytes) or (0, b"") on any transport failure, size
    overrun, deadline exhaustion, or non-https/off-origin URL."""
    if not parent_alive():
        raise Fail("supervising process is gone")
    budget = remaining()
    if budget <= 0:
        return 0, b""
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != "https" or "%s://%s" % (parsed.scheme, parsed.netloc) != API_ORIGIN:
        return 0, b""
    req = urllib.request.Request(url, method="POST" if body is not None else "GET")
    req.add_header("Accept", "application/json")
    req.add_header("User-Agent", "nowah-omarchy")
    if bearer:
        req.add_header("Authorization", "Bearer %s" % bearer)
    data = None
    if body is not None:
        data = json.dumps(body, separators=(",", ":")).encode()
        req.add_header("Content-Type", "application/json")
    opener = urllib.request.build_opener(urllib.request.HTTPSHandler(context=SSL_CONTEXT))
    timeout = min(budget, max(CONNECT_TIMEOUT_S, budget))
    try:
        with opener.open(req, data=data, timeout=timeout) as resp:
            payload = resp.read(limit + 1)  # read one extra byte to detect overrun
            if len(payload) > limit:
                return 0, b""
            return resp.status, payload
    except urllib.error.HTTPError as exc:
        try:
            payload = exc.read(limit + 1)
        except Exception:
            payload = b""
        if len(payload) > limit:
            return 0, b""
        return exc.code, payload
    except Exception:
        return 0, b""


def envelope(payload):
    try:
        doc = json.loads(payload.decode("utf-8", "replace"))
    except ValueError:
        return None
    return doc if isinstance(doc, dict) else None


# --------------------------------------------------------------------------
# credentials
# --------------------------------------------------------------------------


def load_token(state):
    raw = state.read(TOKEN_LEAF, MAX_SECRET_FILE)
    if raw is None:
        return None, False
    text = raw.decode("utf-8", "replace").strip()
    if TOKEN_RE.match(text):  # v1.0.0 bare token: migrate for the production origin only
        if API_ORIGIN != PROD_API_ORIGIN:
            state.remove(TOKEN_LEAF)
            return None, True
        store_token(state, text)
        return text, False
    try:
        doc = json.loads(text)
    except ValueError:
        state.remove(TOKEN_LEAF)
        return None, True
    token = doc.get("token") if isinstance(doc, dict) else None
    if not isinstance(token, str) or not TOKEN_RE.match(token) or doc.get("origin") != API_ORIGIN:
        state.remove(TOKEN_LEAF)
        return None, True
    return token, False


def store_token(state, token):
    if not TOKEN_RE.match(token):
        return False
    body = json.dumps({"origin": API_ORIGIN, "token": token}, separators=(",", ":")).encode()
    state.publish(TOKEN_LEAF, body)
    return True


# --------------------------------------------------------------------------
# subcommands
# --------------------------------------------------------------------------


def cmd_refresh(state):
    prev = load_prev(state)
    token, removed = load_token(state)
    if token is None:
        pairing = prev_pairing(prev)
        auth_error = "origin_mismatch" if removed else prev_auth_error(prev)
        state_name = "signed_out"
        if pairing and pairing.get("expiresAt"):
            try:
                expires = time.mktime(time.strptime(pairing["expiresAt"][:19], "%Y-%m-%dT%H:%M:%S"))
                if expires > time.time():
                    state_name = "pairing"
                else:
                    pairing = None
            except ValueError:
                pairing = None
        else:
            pairing = None
        state.publish(STATUS_LEAF, build_status(state_name, auth_error, pairing, [], 0, None, True, ""))
        return 0

    flight_num = (os.environ.get("NOWAH_FLIGHT") or "").replace(" ", "")
    if not FLIGHT_NUM_RE.match(flight_num):
        flight_num = ""
    flight_date = os.environ.get("NOWAH_FLIGHT_DATE") or ""
    if not DATE_RE.match(flight_date) or len(flight_date) != 10:
        flight_date = ""

    carried_trips = prev_trips(prev)
    carried_unread = prev_unread(prev)
    carried_flight = s_flight_status(prev.get("flightStatus"), flight_num or None, FLIGHT_STATUS_MAX_AGE_S)

    status, payload = request("%s/trips?limit=%d" % (API_ORIGIN, MAX_TRIPS), MAX_BODY_TRIPS, bearer=token)
    if status == 0:
        state.publish(STATUS_LEAF, build_status(
            "signed_in", "", None, carried_trips, carried_unread, carried_flight, False, "network error"))
        return 0
    if status in (401, 403):
        state.remove(TOKEN_LEAF)
        state.publish(STATUS_LEAF, build_status("signed_out", "revoked", None, [], 0, None, True, ""))
        return 0
    if status >= 500:
        state.publish(STATUS_LEAF, build_status(
            "signed_in", "", None, carried_trips, carried_unread, carried_flight, False,
            "server error (%d)" % status))
        return 0
    doc = envelope(payload)
    if not doc or doc.get("success") is not True:
        message = ""
        if doc and isinstance(doc.get("error"), dict):
            message = s_str(doc["error"].get("message"), 120) or ""
        state.publish(STATUS_LEAF, build_status(
            "signed_in", "", None, carried_trips, carried_unread, carried_flight, False,
            message or "sync failed"))
        return 0
    data = doc.get("data") if isinstance(doc.get("data"), dict) else {}
    trips = s_trips(data.get("trips"))

    unread = carried_unread
    if SHOW_NOTIFICATIONS:
        st, body = request("%s/notifications/unread-count" % API_ORIGIN, MAX_BODY_SMALL, bearer=token)
        if st == 200:
            sub = envelope(body) or {}
            count = s_num((sub.get("data") or {}).get("count") if isinstance(sub.get("data"), dict) else None)
            if count is not None:
                unread = int(max(0, min(9999, count)))

    flight_status = carried_flight
    if flight_num:
        url = "%s/flights/%s/status" % (API_ORIGIN, flight_num)
        if flight_date:
            url += "?date=%s" % flight_date
        st, body = request(url, MAX_BODY_SMALL)  # public endpoint: no bearer
        if st == 200:
            sub = envelope(body) or {}
            if sub.get("success") is True:
                flight_status = api_flight_status(sub.get("data"), flight_num)

    if not state.exists(TOKEN_LEAF):  # disconnected while we were syncing
        state.publish(STATUS_LEAF, build_status("signed_out", "", None, [], 0, None, True, ""))
        return 0
    state.publish(STATUS_LEAF, build_status("signed_in", "", None, trips, unread, flight_status, True, ""))
    return 0


def cmd_pair_start(state):
    prev = load_prev(state)
    status, payload = request(
        "%s/device-auth/code" % API_ORIGIN, MAX_BODY_SMALL, body={"clientName": "Omarchy"})
    doc = envelope(payload) if status else None
    if not doc or doc.get("success") is not True:
        message = "network error"
        if doc and isinstance(doc.get("error"), dict):
            message = s_str(doc["error"].get("message"), 120) or "pairing failed"
        state.publish(STATUS_LEAF, build_status(
            "signed_out", message, None, prev_trips(prev), prev_unread(prev), None, False, message))
        raise Fail("pairing request failed: %s" % message)

    data = doc.get("data") if isinstance(doc.get("data"), dict) else {}
    device_code = data.get("deviceCode")
    user_code = data.get("userCode")
    if not isinstance(device_code, str) or not DEVICE_CODE_RE.match(device_code):
        raise Fail("malformed device code from server")
    if not isinstance(user_code, str) or not USER_CODE_RE.match(user_code):
        raise Fail("malformed user code from server")
    expires_in = s_num(data.get("expiresIn"))
    expires_in = 600 if expires_in is None or not (0 < expires_in <= 3600) else int(expires_in)
    interval = s_num(data.get("interval"))
    interval = 5 if interval is None or not (1 <= interval <= 60) else int(interval)
    expires_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + expires_in))

    # deviceCode is a credential: 0600 device.json only, never status.json.
    state.publish(DEVICE_LEAF, json.dumps(
        {"deviceCode": device_code, "expiresAt": expires_at}, separators=(",", ":")).encode())
    # The verification URL is built locally from the validated code and the
    # pinned app origin - a server-supplied URL is never used.
    pairing = {
        "userCode": user_code,
        "verificationUrl": "%s/device?code=%s" % (APP_ORIGIN, user_code),
        "expiresAt": expires_at,
        "interval": interval,
    }
    state.publish(STATUS_LEAF, build_status(
        "pairing", "", pairing, prev_trips(prev), prev_unread(prev), None, True, ""))
    return 0


def cmd_pair_poll(state):
    raw = state.read(DEVICE_LEAF, MAX_SECRET_FILE)
    device_code = None
    if raw is not None:
        try:
            doc = json.loads(raw.decode("utf-8", "replace"))
            candidate = doc.get("deviceCode") if isinstance(doc, dict) else None
            if isinstance(candidate, str) and DEVICE_CODE_RE.match(candidate):
                device_code = candidate
        except ValueError:
            pass
    if device_code is None:
        state.remove(DEVICE_LEAF)
        state.publish(STATUS_LEAF, build_status("signed_out", "", None, [], 0, None, True, ""))
        return 1

    status, payload = request(
        "%s/device-auth/token" % API_ORIGIN, MAX_BODY_SMALL, body={"deviceCode": device_code})
    if status == 0:
        return 10  # transient network problem - keep polling
    doc = envelope(payload)
    if doc and doc.get("success") is True:
        data = doc.get("data") if isinstance(doc.get("data"), dict) else {}
        token = data.get("token")
        if not isinstance(token, str) or not store_token(state, token):
            state.remove(DEVICE_LEAF)
            state.publish(STATUS_LEAF, build_status("signed_out", "pairing failed", None, [], 0, None, True, ""))
            return 0
        state.remove(DEVICE_LEAF)
        return cmd_refresh(state)

    code = ""
    if doc and isinstance(doc.get("error"), dict):
        code = doc["error"].get("code") or ""
    if code in ("authorization_pending", "slow_down"):
        return 10
    if code == "expired_token":
        state.remove(DEVICE_LEAF)
        state.publish(STATUS_LEAF, build_status("signed_out", "expired", None, [], 0, None, True, ""))
        return 0
    if code == "access_denied":
        state.remove(DEVICE_LEAF)
        state.publish(STATUS_LEAF, build_status("signed_out", "denied", None, [], 0, None, True, ""))
        return 0
    return 10


def cmd_disconnect(state):
    state.remove(TOKEN_LEAF)
    state.remove(DEVICE_LEAF)
    state.publish(STATUS_LEAF, build_status("signed_out", "", None, [], 0, None, True, ""))
    return 0


def cmd_read_snapshot(state):
    """Bounded reader for the shell: at most MAX_STATUS_BYTES through the same
    no-follow, non-blocking, fstat-verified primitive. An oversized or
    unusable snapshot exits nonzero and prints nothing."""
    raw = state.read(STATUS_LEAF, MAX_STATUS_BYTES)
    if raw is None:
        return 2
    sys.stdout.buffer.write(raw)
    sys.stdout.buffer.flush()
    return 0


LAUNCHER_CANDIDATES = (
    "/usr/local/bin/omarchy-launch-webapp",
    "/usr/bin/omarchy-launch-webapp",
)


def cmd_launch(path):
    """Open a pinned-origin app URL. The launcher is resolved from a fixed list
    of absolute paths and verified before exec - never found through PATH."""
    if not APP_PATH_RE.match(path):
        raise Fail("refusing to launch a non-app path")
    url = APP_ORIGIN + path
    for candidate in LAUNCHER_CANDIDATES:
        try:
            st = os.stat(candidate, follow_symlinks=True)
        except OSError:
            continue
        if not stat.S_ISREG(st.st_mode) or not (st.st_mode & stat.S_IXUSR):
            continue
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):  # group/world-writable launcher
            continue
        if os.fork() == 0:
            os.setsid()
            env = {
                "PATH": "/usr/local/bin:/usr/bin",
                "HOME": os.environ.get("HOME", ""),
                "DISPLAY": os.environ.get("DISPLAY", ""),
                "WAYLAND_DISPLAY": os.environ.get("WAYLAND_DISPLAY", ""),
                "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", ""),
                "XDG_CURRENT_DESKTOP": os.environ.get("XDG_CURRENT_DESKTOP", ""),
            }
            try:
                os.execve(candidate, [candidate, url], env)
            finally:
                os._exit(127)
        return 0
    raise Fail("no verified omarchy-launch-webapp found")


def main(argv):
    command = argv[1] if len(argv) > 1 else "refresh"
    if command not in ("refresh", "pair-start", "pair-poll", "disconnect", "read-snapshot", "launch"):
        sys.stderr.write(
            "usage: nowah-sync {refresh|pair-start|pair-poll|disconnect|read-snapshot|launch PATH}\n")
        return 2
    if command == "launch":
        return cmd_launch(argv[2] if len(argv) > 2 else "")

    state = State()
    if command == "read-snapshot":  # read-only, no lock needed
        return cmd_read_snapshot(state)
    if not state.lock() or remaining() < 5:
        # Another run owns the state; it publishes a fresh snapshot itself.
        return 10 if command == "pair-poll" else 0
    if command == "refresh":
        return cmd_refresh(state)
    if command == "pair-start":
        return cmd_pair_start(state)
    if command == "pair-poll":
        return cmd_pair_poll(state)
    return cmd_disconnect(state)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Fail as exc:
        sys.stderr.write("nowah-sync: %s\n" % exc)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
