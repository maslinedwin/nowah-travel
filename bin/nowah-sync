#!/usr/bin/env bash
#
# nowah-sync — state synchronizer for the Nowah Omarchy plugin.
#
# Talks ONLY to the pinned Nowah production origin (device-code pairing +
# read-only trip data) and maintains an atomic JSON snapshot at
# $STATE_DIR/status.json which the Quickshell side (NowahService.qml) watches.
#
# Security posture (see README "Privacy & disclosure"):
#   * Secrets never touch any argv: the bearer header travels to curl through
#     a private pipe descriptor (-K /dev/fd/N), request bodies through stdin,
#     and secret material is fed to jq on stdin (-R), never via --arg.
#   * Credentials are bound to the pinned API origin. A developer override
#     exists only via explicit env consent and uses a separate state dir, so
#     a production token can never be replayed to another host.
#   * Every response is size-capped on the wire and again on disk, kept in a
#     private file (never a shell variable), and reduced through a strict
#     whitelist/truncate/strip jq schema before anything reaches status.json.
#   * State I/O is descriptor-bound: the state directory is opened once,
#     verified, locked (flock on the directory itself — there is no lock
#     file), and every leaf is then addressed relative to that descriptor.
#     Reads open the leaf and verify the OPENED object (regular, ours, one
#     link, bounded, same inode the name points at) before reading through
#     that same descriptor; writes go to an O_EXCL temp opened append-only
#     (never truncating anything swapped in), verified the same way, then
#     renamed into place — rename replaces a symlink, it never follows one.
#     Other same-UID plugins are inside the threat model.
#   * One absolute deadline bounds the whole run; each curl gets the
#     remaining budget; the helper stops if its supervising parent is gone.
#
# Subcommands:
#   refresh          sync trips (NOWAH_FLIGHT / NOWAH_FLIGHT_DATE env add flight status)
#   pair-start       begin pairing (verification URL lands in status.json)
#   pair-poll        poll for approval (exit 10 = pending, poll again)
#   disconnect       forget token + pairing

set -euo pipefail
umask 077
export LC_ALL=C   # byte-accurate ${#var}, deterministic [A-Z] ranges and tr

# ---------------------------------------------------------------------------
# pinned origins + developer override
# ---------------------------------------------------------------------------

PROD_API_ORIGIN="https://api.nowah.xyz"
API_ORIGIN="$PROD_API_ORIGIN"
APP_ORIGIN="https://app.nowah.xyz"
STATE_LEAF="nowah-omarchy"

# Developer override: BOTH variables must be set by hand (the plugin never
# sets them — it explicitly unsets them for the helper's environment). The
# override forces its own state directory, so credentials issued by one
# origin are never presented to another.
if [[ -n "${NOWAH_DEV_API_ORIGIN:-}" ]]; then
  if [[ "${NOWAH_DEV_CONSENT:-}" != "1" ]]; then
    echo "nowah-sync: NOWAH_DEV_API_ORIGIN requires NOWAH_DEV_CONSENT=1" >&2
    exit 2
  fi
  if [[ ! "$NOWAH_DEV_API_ORIGIN" =~ ^https://[a-z0-9.-]+(:[0-9]{1,5})?$ ]]; then
    echo "nowah-sync: NOWAH_DEV_API_ORIGIN must be an https origin with no path" >&2
    exit 2
  fi
  API_ORIGIN="$NOWAH_DEV_API_ORIGIN"
  STATE_LEAF="nowah-omarchy-dev"
fi

NOWAH_SHOW_NOTIFICATIONS="${NOWAH_SHOW_NOTIFICATIONS:-0}"

# State base must be an absolute path; fall back to $HOME/.local/state.
STATE_BASE="${XDG_STATE_HOME:-}"
if [[ -z "$STATE_BASE" || "$STATE_BASE" != /* ]]; then
  [[ -n "${HOME:-}" && "$HOME" == /* ]] || { echo "nowah-sync: HOME must be an absolute path" >&2; exit 2; }
  STATE_BASE="$HOME/.local/state"
fi
# A relocated (symlinked) state base is fine as long as it resolves to a
# directory we own; the resolved path is what gets bound and verified below.
if [[ -L "$STATE_BASE" ]]; then
  resolved_base="$(realpath -e "$STATE_BASE" 2>/dev/null || true)"
  [[ -n "$resolved_base" && -d "$resolved_base" && "$(stat -c %u "$resolved_base")" == "$(id -u)" ]] \
    || { echo "nowah-sync: state base symlink does not resolve to a directory we own" >&2; exit 2; }
  STATE_BASE="$resolved_base"
fi
STATE_DIR="$STATE_BASE/$STATE_LEAF"
# Leaf names under the bound state directory (fd 9).
TOKEN_LEAF="token"
DEVICE_LEAF="device.json"
STATUS_LEAF="status.json"

# ---------------------------------------------------------------------------
# bounds
# ---------------------------------------------------------------------------

RUN_BUDGET_S=40                 # absolute deadline for the whole invocation
DEADLINE=$((SECONDS + RUN_BUDGET_S))
MAX_BODY_TRIPS=$((512 * 1024))  # bytes on the wire and on disk
MAX_BODY_SMALL=$((32 * 1024))
MAX_STATUS_BYTES=$((256 * 1024))
MAX_SECRET_FILE=4096
MAX_TRIPS=25
MAX_FLIGHTS=12
FLIGHT_STATUS_MAX_AGE_S=$((12 * 3600))
PARENT_PID="$PPID"

remaining() {
  local r=$((DEADLINE - SECONDS))
  (( r < 1 )) && r=0
  printf '%s' "$r"
}

# Stop doing network work if our supervising parent (the shell's Process,
# via timeout) is gone: reparented to init means we were orphaned.
parent_alive() {
  local ppid
  ppid="$(sed 's/.*) //' "/proc/$$/stat" 2>/dev/null | awk '{print $2}' || true)"
  [[ -n "$ppid" ]] || ppid="$PARENT_PID"
  [[ "$ppid" == "$PARENT_PID" ]]
}

# ---------------------------------------------------------------------------
# private state I/O — descriptor-bound (fd 9 = state dir, fd 8 = scratch,
# fd 7 = current HTTP body)
# ---------------------------------------------------------------------------

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
die() { echo "nowah-sync: $*" >&2; exit 1; }

# fd paths use /proc/self, not /proc/$$: every external command (stat, jq,
# curl, mktemp, mv) inherits our descriptors, and inside a pipeline subshell
# $$ would name the parent shell's table rather than the one holding the fd.
D=""   # "/proc/self/fd/9" once the state directory is bound

# Bind the state directory once. Every later operation goes through $D, so
# what was verified here is what gets used, regardless of what happens to the
# pathname afterwards.
open_state_dir() {
  [[ -d "$STATE_BASE" ]] || mkdir -p "$STATE_BASE"
  [[ ! -L "$STATE_BASE" ]] || die "state base is a symlink: $STATE_BASE"
  [[ "$(stat -c %u "$STATE_BASE")" == "$(id -u)" ]] || die "state base not owned by us"
  local canonical
  canonical="$(realpath -e "$STATE_BASE")/$STATE_LEAF"
  [[ ! -L "$STATE_DIR" ]] || die "state dir is a symlink: $STATE_DIR"
  [[ -e "$STATE_DIR" ]] || mkdir "$STATE_DIR" 2>/dev/null || true
  # -d by name before opening: a planted FIFO would otherwise block the open.
  [[ -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] || die "state dir is not a directory: $STATE_DIR"
  { exec 9<"$STATE_DIR"; } 2>/dev/null || die "cannot open state dir"
  D="/proc/self/fd/9"
  [[ "$(readlink "/proc/self/fd/9")" == "$canonical" ]] || die "state dir resolved elsewhere"
  [[ "$(stat -L -c %F "$D")" == "directory" ]] || die "state dir is not a directory"
  [[ "$(stat -L -c %u "$D")" == "$(id -u)" ]] || die "state dir not owned by us"
  chmod 700 "$D"
  # Sweep temp leaves from runs that died long ago (never a live sibling's).
  find "$D/" -maxdepth 1 -name '.tmp.*' -type f -mmin +10 -delete 2>/dev/null || true
}

# Serialise helper runs on the directory descriptor itself: no lock file, so
# nothing to swap for a symlink and truncate.
acquire_lock() { flock -w "$(remaining)" 9; }

# verify_fd FD MAXSIZE NAMEPATH — the object behind FD must be a regular file
# we own with exactly one link, within MAXSIZE, and the same inode NAMEPATH
# currently points at (so a symlink or swapped leaf is caught after open).
VERIFIED_ID=""   # "dev:ino" of the object verify_fd last accepted

verify_fd() {
  local fd="$1" max="$2" namepath="$3"
  local ftype uid nlink size id_open id_name
  IFS='|' read -r ftype uid nlink size id_open < <(stat -L -c '%F|%u|%h|%s|%d:%i' "/proc/self/fd/$fd" 2>/dev/null || echo '||||')
  id_name="$(stat -c '%d:%i' "$namepath" 2>/dev/null || echo -1)"
  VERIFIED_ID=""
  [[ "$ftype" == "regular file" || "$ftype" == "regular empty file" ]] || return 1
  [[ "$uid" == "$(id -u)" ]] || return 1
  [[ "$nlink" == "1" ]] || return 1
  [[ "$size" =~ ^[0-9]+$ ]] && (( size <= max )) || return 1
  [[ "$id_open" == "$id_name" ]] || return 1
  VERIFIED_ID="$id_open"
  return 0
}

leaf_present() { local p="$D/$1"; [[ -f "$p" && ! -L "$p" ]]; }

# read_leaf NAME MAXBYTES — open, verify the opened object, read through the
# same descriptor. Fails (prints nothing) when the leaf is unusable.
read_leaf() {
  local name="$1" max="$2" p="$D/$1"
  # -f by name first: a planted FIFO would otherwise block the open forever.
  [[ -f "$p" && ! -L "$p" ]] || return 1
  { exec 8<"$p"; } 2>/dev/null || return 1
  if ! verify_fd 8 "$max" "$p"; then
    exec 8<&-
    # Whatever was planted under our name is not ours to keep; unlink never
    # follows a link, so this only ever removes the planted entry itself.
    rm -f "$p"
    return 1
  fi
  head -c "$max" <&8
  exec 8<&-
}

# publish NAME — stdin → fresh O_EXCL 0600 temp (opened append-only, so a
# swapped-in target could never be truncated), verified, then renamed over
# NAME. rename(2) replaces a symlink at NAME; it never follows it.
publish() {
  local name="$1" tmp
  [[ ! -d "$D/$name" || -L "$D/$name" ]] || die "refusing to replace a directory: $name"
  tmp="$(mktemp "$D/.tmp.XXXXXXXX")"
  [[ -f "$tmp" && ! -L "$tmp" ]] || { rm -f "$tmp"; die "temp leaf changed underfoot"; }
  { exec 8>>"$tmp"; } 2>/dev/null || { rm -f "$tmp"; die "cannot open temp leaf"; }
  if ! verify_fd 8 0 "$tmp"; then exec 8>&-; rm -f "$tmp"; die "temp leaf changed underfoot"; fi
  local expected="$VERIFIED_ID"
  cat >&8
  exec 8>&-
  # The rename itself is by name; narrow the window by confirming the name
  # still refers to the object we filled.
  [[ "$(stat -c '%d:%i' "$tmp" 2>/dev/null)" == "$expected" ]] || { rm -f "$tmp"; die "temp leaf swapped before publish"; }
  mv -T -f "$tmp" "$D/$name"
}

# remove_leaf NAME — unlink never follows a symlink; directories are refused.
remove_leaf() {
  local p="$D/$1"
  [[ -e "$p" || -L "$p" ]] || return 0
  [[ ! -d "$p" || -L "$p" ]] || die "refusing to remove a directory: $1"
  rm -f "$p"
}

# ---------------------------------------------------------------------------
# strict schemas — the only path into status.json (also applied to carried
# state from a previous snapshot, so legacy data can never bypass them)
# ---------------------------------------------------------------------------

# Shared jq prelude: bounded, markup/control-stripped strings; finite numbers.
JQ_PRELUDE='
  def s($n): if type == "string" then (gsub("[<>\\p{Cc}\\p{Cf}]"; "") | .[0:$n]) else null end;
  def ident: if type == "string" and test("^[A-Za-z0-9_-]{1,64}$") then . else null end;
  def dt: if type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}") then .[0:32] else null end;
  def num: (if type == "number" then . else (tonumber? // null) end)
           | if . == null then null elif (isinfinite or isnan or . > 1e9 or . < -1e9) then null else . end;
'

TRIP_LIST_SCHEMA="$JQ_PRELUDE"'
  if type != "array" then [] else . end
  | map(select(type == "object"))
  | .[0:'"$MAX_TRIPS"']
  | map({
      id: (.id | ident),
      name: (.name | s(80)),
      status: (.status | s(32)),
      tripStatus: (.tripStatus | s(32)),
      startDate: (.startDate | dt),
      endDate: (.endDate | dt),
      dateRange: (if (.dateRange|type) == "object"
                   then {start: (.dateRange.start | dt), end: (.dateRange.end | dt)}
                   else null end),
      destination: (.destination | s(80)),
      destinationCity: (.destinationCity | s(60)),
      destinationCountry: (.destinationCountry | s(60)),
      weather: (if (.weather|type) == "object"
                 then {temp: (.weather.temp | num), condition: (.weather.condition | s(40))}
                 else null end),
      flights: ((.flights // []) | if type != "array" then [] else . end
                | map(select(type == "object"))
                | .[0:'"$MAX_FLIGHTS"']
                | map({
                    flightNumber: (.flightNumber | s(12)),
                    depCode: (.depCode | s(4)),
                    arrCode: (.arrCode | s(4)),
                    depAt: (.depAt | dt),
                    arrAt: (.arrAt | dt)
                  }))
    })
  | map(select(.id != null))
'

TRIPS_RESPONSE_SCHEMA='(.data.trips // []) | '"$TRIP_LIST_SCHEMA"

# Public flight-status payload: top-level status/progress, nested delays/gate.
FLIGHT_SCHEMA="$JQ_PRELUDE"'
  (.data // {}) | if type != "object" then {} else . end
  | {
      status: ((.status // .flightStatus) | s(24)),
      delayMinutes: ((.delayMinutes // .departureDelay // .delays.departure) | num),
      progressPercent: ((.progressPercent // .progress) | num),
      gate: ((.gate // .departureGate // .departure.gate) | s(8)),
      terminal: ((.terminal // .departure.terminal) | s(8))
    }
'

FLIGHT_CARRY_SCHEMA="$JQ_PRELUDE"'
  if type != "object" then null else
    { flightNumber: (.flightNumber | s(12)), fetchedAt: (.fetchedAt | dt),
      data: ((.data // {}) | if type != "object" then {} else . end
             | { status: (.status | s(24)), delayMinutes: (.delayMinutes | num),
                 progressPercent: (.progressPercent | num), gate: (.gate | s(8)), terminal: (.terminal | s(8)) }) }
  end
'

# Read a jq expression out of the existing status file (fallback when absent).
# prev EXPR FALLBACK — read the previous snapshot; it must be exactly one JSON
# document (slurp + length check) or the fallback is used. Every carried value
# is then passed through its own schema by the prev_* helpers below.
prev() {
  local expr="$1" fallback="${2:-null}" out=""
  out="$(read_leaf "$STATUS_LEAF" "$MAX_STATUS_BYTES" \
    | jq -cs "if length == 1 then ((.[0] | $expr) // $fallback) else $fallback end" 2>/dev/null)" || out=""
  [[ -n "$out" ]] || out="$fallback"
  printf '%s' "$out"
}

PAIRING_CARRY_SCHEMA="$JQ_PRELUDE"'
  if type != "object" then null else
    (.userCode | if type == "string" and test("^[A-Z0-9]{4}-[A-Z0-9]{4}$") then . else null end) as $code
    | if $code == null then null else
      { userCode: $code,
        verificationUrl: (if .verificationUrl == ($app + "/device?code=" + $code) then .verificationUrl else null end),
        expiresAt: (.expiresAt | dt),
        interval: ((.interval | num) | if . == null then 5 else ([1, ([60, .] | min)] | max | floor) end) }
      end
  end
'

prev_pairing() { prev '.auth.pairing' | jq -c --arg app "$APP_ORIGIN" "$PAIRING_CARRY_SCHEMA" 2>/dev/null || printf 'null'; }
prev_error() { prev '.auth.error' | jq -r "$JQ_PRELUDE"' (s(120)) // ""' 2>/dev/null || true; }

prev_trips() { prev '.trips' '[]' | jq -c "$TRIP_LIST_SCHEMA" 2>/dev/null || printf '[]'; }
prev_unread() { prev '.unreadCount' '0' | jq -c 'if type == "number" and . >= 0 and . <= 9999 then floor else 0 end' 2>/dev/null || printf '0'; }

# prev_flight FLIGHTNUM — carried flight status only for the same flight and
# only while fresh; anything else is dropped rather than shown stale.
prev_flight() {
  local want="$1"
  [[ -n "$want" ]] || { printf 'null'; return; }
  prev '.flightStatus' | jq -c "$FLIGHT_CARRY_SCHEMA" 2>/dev/null \
    | jq -c --arg want "$want" --argjson maxAge "$FLIGHT_STATUS_MAX_AGE_S" '
        if . == null or .flightNumber != $want or .fetchedAt == null then null
        else ((.fetchedAt | try fromdateiso8601 catch 0) as $t
              | if (now - $t) > $maxAge then null else . end) end' 2>/dev/null \
    || printf 'null'
}

# write_status STATE AUTH_ERROR PAIRING TRIPS UNREAD FLIGHTSTATUS OK SYNC_ERROR
write_status() {
  local doc
  doc="$(jq -cn \
    --arg at "$(now_iso)" \
    --arg state "$1" \
    --arg autherr "$2" \
    --argjson pairing "$3" \
    --argjson trips "$4" \
    --argjson unread "$5" \
    --argjson flight "$6" \
    --argjson ok "$7" \
    --arg syncerr "$8" \
    '{
      version: 1,
      generatedAt: $at,
      auth: {
        state: $state,
        error: (if $autherr == "" then null else $autherr[0:120] end),
        pairing: $pairing,
        profile: null
      },
      trips: $trips,
      unreadCount: $unread,
      flightStatus: $flight,
      lastSync: { ok: $ok, at: $at, error: (if $syncerr == "" then null else $syncerr[0:120] end) }
    }')"
  if (( ${#doc} + 1 > MAX_STATUS_BYTES )); then
    # Fail closed: never publish an oversized snapshot.
    doc="$(jq -cn --arg at "$(now_iso)" --arg state "$1" \
      '{version:1, generatedAt:$at, auth:{state:$state,error:null,pairing:null,profile:null},
        trips:[], unreadCount:0, flightStatus:null,
        lastSync:{ok:false, at:$at, error:"snapshot exceeded size limit"}}')"
  fi
  printf '%s\n' "$doc" | publish "$STATUS_LEAF"
}

preflight() {
  local missing=""
  command -v curl >/dev/null 2>&1 || missing="curl"
  command -v jq >/dev/null 2>&1 || missing="${missing:+$missing }jq"
  command -v flock >/dev/null 2>&1 || missing="${missing:+$missing }flock"
  if [[ -n "$missing" ]]; then
    local at
    at="$(now_iso)"
    printf '{"version":1,"generatedAt":"%s","auth":{"state":"signed_out","error":"missing dependency: %s","pairing":null,"profile":null},"trips":[],"unreadCount":0,"flightStatus":null,"lastSync":{"ok":false,"at":"%s","error":"missing dependency: %s"}}\n' \
      "$at" "$missing" "$at" "$missing" | publish "$STATUS_LEAF"
    die "missing dependency: $missing"
  fi
}

# ---------------------------------------------------------------------------
# HTTP — bodies stay in a private file; secrets never enter any argv
# ---------------------------------------------------------------------------

HTTP_CODE=""
HTTP_BODY_FILE=""   # "/proc/self/fd/7" while a body is held — all reads go via the descriptor
HTTP_BODY_PATH=""   # the temp leaf's name, used only to unlink it

cleanup_body() {
  { exec 7>&-; } 2>/dev/null || true
  [[ -n "$HTTP_BODY_PATH" ]] && rm -f "$HTTP_BODY_PATH"
  HTTP_BODY_PATH=""; HTTP_BODY_FILE=""
}
trap cleanup_body EXIT

# request URL MAXBYTES [BEARER] [JSON_BODY]
#   Bearer header (if any) is delivered via a curl config on a private pipe
#   descriptor; the JSON body (if any) via stdin (curl infers POST). Sets
#   HTTP_CODE and leaves the (size-capped) body in HTTP_BODY_FILE. Nonzero
#   return = transport failure, size overrun, or deadline exhausted ("000").
request() {
  local url="$1" max="$2" bearer="${3:-}" body="${4:-}"
  cleanup_body
  HTTP_CODE="000"
  parent_alive || exit 143
  local budget
  budget="$(remaining)"
  (( budget > 0 )) || return 1
  # Body leaf: O_EXCL temp, opened append-only and verified, then handed to
  # curl and jq ONLY as the descriptor's magic link — never re-resolved by name.
  HTTP_BODY_PATH="$(mktemp "$D/.tmp.XXXXXXXX")"
  { exec 7>>"$HTTP_BODY_PATH"; } 2>/dev/null || { rm -f "$HTTP_BODY_PATH"; HTTP_BODY_PATH=""; return 1; }
  if ! verify_fd 7 0 "$HTTP_BODY_PATH"; then cleanup_body; return 1; fi
  HTTP_BODY_FILE="/proc/self/fd/7"

  # -q FIRST: never read ~/.curlrc, which could alter TLS/proxy/redirect posture.
  local -a args=(-q --silent
                 --max-time "$budget" --connect-timeout 10
                 --max-filesize "$max" --proto '=https' --tlsv1.2
                 -o "$HTTP_BODY_FILE" -w '%{http_code} %{exitcode}')
  local cfg=""
  if [[ -n "$bearer" ]]; then
    cfg="header = \"Authorization: Bearer ${bearer}\""
  fi
  if [[ -n "$body" ]]; then
    args+=(-H 'Content-Type: application/json' --data-binary '@-')
  fi

  local out="" code="" rc=""
  # fd 3 carries the config (header) through an anonymous pipe; stdin the body.
  if [[ -n "$cfg" ]]; then
    out="$(printf '%s' "$body" | curl "${args[@]}" -K /dev/fd/3 "$url" 3< <(printf '%s\n' "$cfg") 2>/dev/null)" || true
  else
    out="$(printf '%s' "$body" | curl "${args[@]}" "$url" 2>/dev/null)" || true
  fi
  code="${out%% *}"; rc="${out##* }"
  [[ "$code" =~ ^[0-9]{3}$ ]] || code="000"
  # Any curl-level failure (incl. --max-filesize overrun, rc 63) is a transport
  # failure regardless of the HTTP status that came with it.
  [[ "$rc" == "0" ]] || code="000"
  if (( $(stat -L -c %s "$HTTP_BODY_FILE" 2>/dev/null || echo 0) > max )); then
    : > "$HTTP_BODY_FILE"
    code="000"
  fi
  HTTP_CODE="$code"
  [[ "$HTTP_CODE" != "000" ]]
}

# body_get EXPR FALLBACK — jq over the body file, tolerating non-JSON.
body_get() {
  local expr="$1" fallback="${2:-null}"
  [[ -n "$HTTP_BODY_FILE" ]] && (( $(stat -L -c %s "$HTTP_BODY_FILE" 2>/dev/null || echo 0) > 0 )) || { printf '%s' "$fallback"; return; }
  jq -c "$expr // $fallback" "$HTTP_BODY_FILE" 2>/dev/null || printf '%s' "$fallback"
}

# body_str EXPR — like body_get but unwraps a JSON string ("" when absent).
body_str() { body_get "$1" '""' | jq -r . 2>/dev/null || true; }

# ---------------------------------------------------------------------------
# credential handling (secret material only ever flows through pipes)
# ---------------------------------------------------------------------------

TOKEN_RE='^nowah_dev_[A-Za-z0-9_-]{20,128}$'

# load_token — prints the bearer token bound to API_ORIGIN, or fails.
#   A bare-string token written by v1.0.0 is migrated into the bound format
#   (production origin only); anything else that does not match is removed.
load_token() {
  local raw origin token
  raw="$(read_leaf "$TOKEN_LEAF" "$MAX_SECRET_FILE")" || return 1
  raw="${raw%$'\n'}"
  if [[ "$raw" =~ $TOKEN_RE ]]; then
    [[ "$API_ORIGIN" == "$PROD_API_ORIGIN" ]] || { remove_leaf "$TOKEN_LEAF"; return 1; }
    store_token "$raw" || return 1
    printf '%s' "$raw"
    return 0
  fi
  origin="$(printf '%s' "$raw" | jq -r '.origin // empty' 2>/dev/null || true)"
  token="$(printf '%s' "$raw" | jq -r '.token // empty' 2>/dev/null || true)"
  if [[ "$origin" != "$API_ORIGIN" || ! "$token" =~ $TOKEN_RE ]]; then
    remove_leaf "$TOKEN_LEAF"
    return 1
  fi
  printf '%s' "$token"
}

store_token() {
  local token="$1"
  [[ "$token" =~ $TOKEN_RE ]] || return 1
  printf '%s' "$token" | jq -Rc --arg origin "$API_ORIGIN" '{origin: $origin, token: .}' | publish "$TOKEN_LEAF"
}

# ---------------------------------------------------------------------------
# refresh — flight lookup driven by NOWAH_FLIGHT / NOWAH_FLIGHT_DATE env
#           (never argv: a flight number identifies the user's travel)
# ---------------------------------------------------------------------------

cmd_refresh() {
  local flight_num="${NOWAH_FLIGHT:-}" flight_date="${NOWAH_FLIGHT_DATE:-}"
  flight_num="${flight_num// /}"
  [[ "$flight_num" =~ ^[A-Z0-9]{2,8}$ ]] || flight_num=""
  [[ "$flight_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || flight_date=""

  local token=""
  if ! token="$(load_token)"; then
    # Not signed in. Never clobber an in-flight pairing (or the auth error
    # explaining why we are signed out) — pair-start/pair-poll own those.
    local pairing autherr state exp
    pairing="$(prev_pairing)"
    autherr="$(prev_error)"
    state="signed_out"
    if [[ "$pairing" != "null" ]]; then
      exp="$(printf '%s' "$pairing" | jq -r 'if type == "object" then (.expiresAt // empty) else empty end' 2>/dev/null || true)"
      if [[ "$exp" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$ ]] \
         && [[ "$(date -u -d "$exp" +%s 2>/dev/null || echo 0)" -gt "$(date -u +%s)" ]]; then
        state="pairing"
      else
        pairing="null"
      fi
    fi
    write_status "$state" "$autherr" "$pairing" '[]' 0 null true ""
    return 0
  fi

  local carried_trips carried_unread carried_flight
  carried_trips="$(prev_trips)"
  carried_unread="$(prev_unread)"
  carried_flight="$(prev_flight "$flight_num")"

  # --- trips ---
  if ! request "$API_ORIGIN/trips?limit=$MAX_TRIPS" "$MAX_BODY_TRIPS" "$token"; then
    write_status "signed_in" "" null "$carried_trips" "$carried_unread" "$carried_flight" false "network error"
    return 0
  fi
  case "$HTTP_CODE" in
    401|403)
      remove_leaf "$TOKEN_LEAF"
      write_status "signed_out" "revoked" null '[]' 0 null true ""
      return 0
      ;;
    5??)
      write_status "signed_in" "" null "$carried_trips" "$carried_unread" "$carried_flight" false "server error ($HTTP_CODE)"
      return 0
      ;;
  esac
  if [[ "$(body_get '.success' 'false')" != "true" ]]; then
    local msg
    msg="$(body_str '.error.message')"
    write_status "signed_in" "" null "$carried_trips" "$carried_unread" "$carried_flight" false "${msg:-sync failed}"
    return 0
  fi
  local trips
  trips="$(jq -c "$TRIPS_RESPONSE_SCHEMA" "$HTTP_BODY_FILE" 2>/dev/null || printf '[]')"

  # --- unread notifications (optional) ---
  local unread="$carried_unread"
  if [[ "$NOWAH_SHOW_NOTIFICATIONS" == "1" ]]; then
    if request "$API_ORIGIN/notifications/unread-count" "$MAX_BODY_SMALL" "$token" \
        && [[ "$HTTP_CODE" == "200" ]]; then
      unread="$(body_get '(.data.count | if type == "number" then (floor | if . < 0 then 0 elif . > 9999 then 9999 else . end) else null end)' "$carried_unread")"
    fi
  fi

  # --- public flight status (optional, no auth, strictly validated inputs) ---
  local flight_status="$carried_flight"
  if [[ -n "$flight_num" ]]; then
    local url="$API_ORIGIN/flights/$flight_num/status"
    [[ -n "$flight_date" ]] && url="$url?date=$flight_date"
    if request "$url" "$MAX_BODY_SMALL" && [[ "$HTTP_CODE" == "200" ]] \
        && [[ "$(body_get '.success' 'false')" == "true" ]]; then
      flight_status="$(jq -cn --arg num "$flight_num" --arg at "$(now_iso)" \
        --argjson data "$(jq -c "$FLIGHT_SCHEMA" "$HTTP_BODY_FILE" 2>/dev/null || printf '{}')" \
        '{flightNumber: $num, fetchedAt: $at, data: $data}')"
    fi
  fi

  # A disconnect cannot interleave (flock), but never publish signed_in
  # unless the credential is still on disk.
  leaf_present "$TOKEN_LEAF" || { write_status "signed_out" "" null '[]' 0 null true ""; return 0; }
  write_status "signed_in" "" null "$trips" "$unread" "$flight_status" true ""
}

# ---------------------------------------------------------------------------
# pair-start
# ---------------------------------------------------------------------------

cmd_pair_start() {
  # No hostname or other machine identifiers leave the device.
  local req='{"clientName":"Omarchy"}'
  if ! request "$API_ORIGIN/device-auth/code" "$MAX_BODY_SMALL" "" "$req"; then
    write_status "signed_out" "network error" null "$(prev_trips)" "$(prev_unread)" null false "network error"
    die "pairing request failed (network)"
  fi
  if [[ "$(body_get '.success' 'false')" != "true" ]]; then
    local msg
    msg="$(body_str '.error.message')"; msg="${msg:-pairing failed}"
    write_status "signed_out" "$msg" null "$(prev_trips)" "$(prev_unread)" null false "$msg"
    die "pairing request failed: $msg"
  fi

  local user_code expires_in interval expires_at
  user_code="$(body_str '.data.userCode' | tr -cd 'A-Z0-9-' | head -c 9)"
  expires_in="$(body_get '(.data.expiresIn | if type == "number" and . > 0 and . <= 3600 then floor else 600 end)' '600')"
  interval="$(body_get '(.data.interval | if type == "number" and . >= 1 and . <= 60 then floor else 5 end)' '5')"
  [[ "$user_code" =~ ^[A-Z0-9]{4}-[A-Z0-9]{4}$ ]] || die "malformed user code from server"
  expires_at="$(date -u -d "+${expires_in} seconds" +%Y-%m-%dT%H:%M:%SZ)"

  # deviceCode is a credential: it flows body-file → jq(stdin) → 0600
  # device.json, never through a shell variable or argv, and NEVER status.json.
  local device_ok
  device_ok="$(jq -r '.data.deviceCode | if type == "string" and test("^[a-f0-9]{64}$") then "ok" else "bad" end' "$HTTP_BODY_FILE" 2>/dev/null || echo bad)"
  [[ "$device_ok" == "ok" ]] || die "malformed device code from server"
  jq -c --arg expiresAt "$expires_at" '{deviceCode: .data.deviceCode, expiresAt: $expiresAt}' "$HTTP_BODY_FILE" | publish "$DEVICE_LEAF"

  # The verification URL is built locally from the validated code and the
  # pinned app origin — a server-supplied URL is never launched.
  local verify_url="$APP_ORIGIN/device?code=$user_code"
  local pairing
  pairing="$(jq -cn --arg userCode "$user_code" --arg verificationUrl "$verify_url" \
    --arg expiresAt "$expires_at" --argjson interval "$interval" \
    '{userCode: $userCode, verificationUrl: $verificationUrl, expiresAt: $expiresAt, interval: $interval}')"
  write_status "pairing" "" "$pairing" "$(prev_trips)" "$(prev_unread)" null true ""
}

# ---------------------------------------------------------------------------
# pair-poll — exit 10 means "authorization pending, poll again"
# ---------------------------------------------------------------------------

cmd_pair_poll() {
  local device_ok
  device_ok="$(read_leaf "$DEVICE_LEAF" "$MAX_SECRET_FILE" \
    | jq -r '.deviceCode | if type == "string" and test("^[a-f0-9]{64}$") then "ok" else "bad" end' 2>/dev/null || echo bad)"
  if [[ "$device_ok" != "ok" ]]; then
    remove_leaf "$DEVICE_LEAF"
    write_status "signed_out" "" null '[]' 0 null true ""
    return 1
  fi

  # Request body built from the device file on stdin — the code never enters
  # a shell variable or any argv.
  local req
  req="$(read_leaf "$DEVICE_LEAF" "$MAX_SECRET_FILE" | jq -c '{deviceCode: .deviceCode}')"
  if ! request "$API_ORIGIN/device-auth/token" "$MAX_BODY_SMALL" "" "$req"; then
    return 10 # transient network problem — keep polling
  fi

  if [[ "$(body_get '.success' 'false')" == "true" ]]; then
    local token
    token="$(body_str '.data.token')"
    if ! store_token "$token"; then
      # The grant was consumed server-side but the token is unusable: fail
      # closed rather than poll a redeemed code forever.
      remove_leaf "$DEVICE_LEAF"
      write_status "signed_out" "pairing failed" null '[]' 0 null true ""
      return 0
    fi
    remove_leaf "$DEVICE_LEAF"
    cmd_refresh
    return 0
  fi

  case "$(body_str '.error.code')" in
    authorization_pending|slow_down) return 10 ;;
    expired_token)
      remove_leaf "$DEVICE_LEAF"
      write_status "signed_out" "expired" null '[]' 0 null true ""
      return 0 ;;
    access_denied)
      remove_leaf "$DEVICE_LEAF"
      write_status "signed_out" "denied" null '[]' 0 null true ""
      return 0 ;;
    *) return 10 ;;
  esac
}

# ---------------------------------------------------------------------------
# disconnect
# ---------------------------------------------------------------------------

cmd_disconnect() {
  remove_leaf "$TOKEN_LEAF"
  remove_leaf "$DEVICE_LEAF"
  write_status "signed_out" "" null '[]' 0 null true ""
}

# ---------------------------------------------------------------------------

main() {
  open_state_dir
  preflight
  local cmd="${1:-refresh}"
  case "$cmd" in
    refresh|pair-start|pair-poll|disconnect) ;;
    *)
      echo "usage: nowah-sync {refresh | pair-start | pair-poll | disconnect}" >&2
      return 2 ;;
  esac
  if ! acquire_lock || (( $(remaining) < 5 )); then
    # Another helper run owns (or just finished owning) the state; a fresh
    # snapshot is already on disk, so publishing a "network error" would lie.
    [[ "$cmd" == "pair-poll" ]] && return 10
    return 0
  fi
  case "$cmd" in
    refresh) cmd_refresh ;;
    pair-start) cmd_pair_start ;;
    pair-poll) cmd_pair_poll ;;
    disconnect) cmd_disconnect ;;
  esac
}

main "$@"
